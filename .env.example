# Vorlage für die Server-.env. Kopieren nach `.env` und ausfüllen:
#   cp .env.example .env
# Die echte .env NIE committen (steht in .gitignore).

# Auth-Token für die claude-CLI, erzeugt mit `claude setup-token` auf dem
# Server (interaktiv, einmalig). Ohne diesen Token kann die Web-UI keine
# Diagramme erzeugen.
CLAUDE_CODE_OAUTH_TOKEN=

# Geteiltes Passwort, das die gesamte Web-UI schützt. Ein starkes,
# einzigartiges Passwort generieren (z.B. `openssl rand -base64 24`) — nirgendwo
# sonst wiederverwenden. Wer dieses Passwort hat, kann beliebige Shell-Befehle
# im Container ausführen (siehe README, Abschnitt "Sicherheit") — wie
# Root-Zugriff behandeln.
APP_PASSWORD=

# Zufalls-Secret zum Signieren der Session-Cookies, einmalig generieren mit
# `openssl rand -hex 32`. Eine Änderung meldet alle aktiven Sessions ab.
SESSION_SECRET=

# Port, auf dem die Web-UI im Container lauscht (Default 5173).
# Muss zum Port-Mapping in docker-compose.yml passen, falls geändert.
PORT=5173
